apiVersion: gateway.k8s.f5.com/v1alpha1
kind: Infra
metadata:
  name: infra
  namespace: f5-cne-system
spec:
  ipams:
  - name: external-selfip
    ipPools:
    - rangeStart: "{{ .ExtSelfStart }}"
      rangeEnd: "{{ .ExtSelfEnd }}"
{{- if .IntSelfIP }}
  - name: internal-selfip
    ipPools:
    - rangeStart: "{{ .IntSelfStart }}"
      rangeEnd: "{{ .IntSelfEnd }}"
{{- end }}
  - name: listener-pool
    ipPools:
{{- if .AliasListenerStart }}
    - rangeStart: "{{ .AliasListenerStart }}"
      rangeEnd: "{{ .AliasListenerEnd }}"
{{- else }}
    - rangeStart: "{{ .ListenerStart }}"
      rangeEnd: "{{ .ListenerEnd }}"
{{- end }}
  networkAttachments:
  - name: external-attach
    networkAttachmentDefinitions:
    - name: tmm-ext
{{- if .IntSelfIP }}
  - name: internal-attach
    networkAttachmentDefinitions:
    - name: tmm-int
{{- end }}
  networks:
  - name: external
    type: vlan
    vlan:
      tag: 0
      mtu: {{ .TmmMtu }}
      networkAttachmentRef:
        name: external-attach
      ipamRefs:
      - name: external-selfip
{{- if .IntSelfIP }}
  - name: internal
    type: vlan
    vlan:
      tag: 0
      mtu: {{ .TmmMtu }}
      networkAttachmentRef:
        name: internal-attach
      ipamRefs:
      - name: internal-selfip
{{- end }}
  egressDefaults:
    networkRef:
      name: external
    port: {{ if .VxlanPort }}{{ .VxlanPort }}{{ else }}4789{{ end }}
    subnet: 192.168.0.0/16
  staticRoutes:
  - name: route-ext-gw
    destinations:
    - "{{ .ExtGwIP }}/32"
    networkRef:
      name: external
{{- if .AgentExtIP }}
  - name: route-agent-node
    destinations:
    - "{{ .AgentExtIP }}/32"
    nextHop: {{ .TmmPodGW }}
{{- end }}
{{- if .MainCidr }}
  - name: route-mgmt-nodes
    destinations:
    - "{{ .MainCidr }}"
    nextHop: {{ .TmmPodGW }}
{{- end }}
  - name: route-cluster-pods
    destinations:
    - "{{ .MainPodsDest }}/{{ .MainPodsPrefixLen }}"
    nextHop: {{ .TmmPodGW }}
  - name: route-cluster-svcs
    destinations:
    - "{{ .MainSvcsDest }}/{{ .MainSvcsPrefixLen }}"
    nextHop: {{ .TmmPodGW }}
  - name: route-default-egress
    destinations:
    - "0.0.0.0/0"
    nextHop: {{ .ExtGwIP }}
---
apiVersion: k8s.f5net.com/v1
kind: F5BigDnsCache
metadata:
  name: aigw-dns-resolver
  namespace: f5-cne-system
spec:
  cacheType: net-resolver
  netResolver:
    useIpv4: true
    useIpv6: false
    forwardZones:
      - forwardZone: "."
        nameServers:
          - ipAddress: 8.8.8.8
            port: 53
          - ipAddress: 1.1.1.1
            port: 53

