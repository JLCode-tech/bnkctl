# Rendered by internal/k8s/render.RenderIngressVxlanRoutes from Phase51-
# discovered per-agent-node (pod CIDR, vxlan100 VTEP) pairs — see
# internal/gcp/phases/phase51_ingress_vxlan.go's doc comment for the full
# asymmetric-routing root cause this fixes.
#
# One F5SPKStaticRoute per agent-pool node that has a live vxlan100 VTEP
# (i.e. is actually hosting an egress-namespace pod): more specific than
# route-cluster-pods (the cluster-wide pod CIDR, phase41) so it only
# overrides TMM-originated (ingress) delivery to THAT node's pods, steering
# it over the same vxlan egress uses instead of the standard Cilium route —
# proven live on cluster bnk-hostdev 2026-07-21.
{{- range $i, $r := .Routes }}
{{- if $i }}
---
{{- end }}
apiVersion: k8s.f5net.com/v1
kind: F5SPKStaticRoute
metadata:
  name: {{ $r.Name }}
  namespace: f5-cne-system
spec:
  destination: {{ $r.Destination }}
  prefixLen: {{ $r.PrefixLen }}
  gateway: {{ $r.Gateway }}
  type: gateway
{{- end }}
