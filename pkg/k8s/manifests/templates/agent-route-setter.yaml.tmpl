# Rendered by internal/k8s/render.RenderAgentRouteSetter from cluster.yaml
# (cluster.agentPool.name, network.external.podsCidr, DERIVED ExtGwIP) +
# Phase25-discovered state (AGENT_EXT_IFACE) — docs/SPEC-go-tracer.md §5
# per-file mapping. Converted from the bash seed's
# reference/bash-seed/manifests/07-agent-route-setter.yaml.tmpl (${VAR}
# envsubst) to Go text/template placeholders.
#
# Agent nodes need `<ext-pods-cidr> via <ext-gw> dev <ext-iface>` so
# pseudo-CNI vxlan-encapsulated egress traffic reaches the TMM node
# (reference/TRIAL-NOTES.md item 7: "agent-node 10.31.0.0/24 via 10.30.0.1 —
# added manually, NOT persisted; gkebnkctl must own"). Reconciles like
# static/07-node-sysctls.json's core_pattern loop so it survives route
# flushes / node restarts, instead of being a one-shot `gcloud ssh` command.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: bnk-agent-route-setter
  namespace: f5-utils
  labels:
    app.kubernetes.io/managed-by: gkebnkctl
    app.kubernetes.io/name: bnk-agent-route-setter
    app.kubernetes.io/part-of: bnk
spec:
  revisionHistoryLimit: 10
  selector:
    matchLabels:
      app.kubernetes.io/name: bnk-agent-route-setter
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bnk-agent-route-setter
        app.kubernetes.io/part-of: bnk
    spec:
      hostPID: true
      hostNetwork: true
      nodeSelector:
        cloud.google.com/gke-nodepool: {{ .AgentPoolName }}
      tolerations:
      - operator: Exists
      restartPolicy: Always
      terminationGracePeriodSeconds: 1
      containers:
      - name: route-setter
        image: busybox:1.36
        securityContext:
          privileged: true
          runAsUser: 0
        command:
        - /bin/sh
        - -c
        - |
          set -eu
          want_cidr='{{ .ExtPodsCidr }}'
          want_gw='{{ .ExtGwIP }}'
          want_dev='{{ .AgentExtIface }}'
          while :; do
            nsenter -t 1 -m -u -n -i -- ip rule add to 10.86.0.0/14 lookup main pref 765 2>/dev/null || true
            nsenter -t 1 -m -u -n -i -- ip rule add to 10.87.0.0/20 lookup main pref 766 2>/dev/null || true
            have=$(nsenter -t 1 -m -u -n -i -- ip route show "$want_cidr" 2>/dev/null || echo '')
            case "$have" in
              *"via $want_gw"*"dev $want_dev"*) ;;
              *)
                echo "$(date -Iseconds) route drift for $want_cidr (have='$have') — reapplying via $want_gw dev $want_dev"
                nsenter -t 1 -m -u -n -i -- ip route replace "$want_cidr" via "$want_gw" dev "$want_dev"
                ;;
            esac
            nsenter -t 1 -m -u -n -i -- iptables -t nat -C POSTROUTING -o "$want_dev" -j MASQUERADE 2>/dev/null || \
              nsenter -t 1 -m -u -n -i -- iptables -t nat -I POSTROUTING 1 -o "$want_dev" -j MASQUERADE
            sleep 60
          done
