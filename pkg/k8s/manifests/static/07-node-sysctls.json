{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "gkebnkctl",
      "app.kubernetes.io/name": "bnk-node-sysctls",
      "app.kubernetes.io/part-of": "bnk"
    },
    "name": "bnk-node-sysctls",
    "namespace": "f5-utils"
  },
  "spec": {
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "bnk-node-sysctls"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "bnk-node-sysctls",
          "app.kubernetes.io/part-of": "bnk"
        }
      },
      "spec": {
        "containers": [
          {
            "command": [
              "/bin/sh",
              "-c",
              "set -eu\nwant='/shared/core/core.%e.%p.%t'\nwhile :; do\n  have=$(nsenter -t 1 -m -u -n -i -- cat /proc/sys/kernel/core_pattern 2>/dev/null || echo '')\n  if [ \"$have\" != \"$want\" ]; then\n    echo \"$(date -Iseconds) core_pattern drift: have='$have' want='$want' — reapplying\"\n    nsenter -t 1 -m -u -n -i -- sh -c \"echo '$want' > /proc/sys/kernel/core_pattern\"\n  else\n    echo \"$(date -Iseconds) core_pattern ok: $have\"\n  fi\n  sleep 60\ndone\n"
            ],
            "image": "busybox:1.36",
            "imagePullPolicy": "IfNotPresent",
            "name": "apply-sysctls",
            "resources": {},
            "securityContext": {
              "privileged": true,
              "runAsUser": 0
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "hostPID": true,
        "nodeSelector": {
          "app": "f5-tmm"
        },
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 1,
        "tolerations": [
          {
            "key": "dpu",
            "operator": "Equal",
            "value": "true"
          },
          {
            "operator": "Exists"
          }
        ]
      }
    },
    "updateStrategy": {
      "rollingUpdate": {
        "maxSurge": 0,
        "maxUnavailable": 1
      },
      "type": "RollingUpdate"
    }
  }
}
