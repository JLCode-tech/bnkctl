apiVersion: v1
kind: Pod
metadata:
  name: iface-discovery
  namespace: {{ .Namespace }}
spec:
  nodeName: {{ .NodeName }}
  hostNetwork: true
  hostPID: true
  restartPolicy: Never
  tolerations:
    - operator: Exists
  containers:
    - name: probe
      image: alpine:3.20
      securityContext:
        privileged: true
      volumeMounts:
        - name: hostsys
          mountPath: /host/sys
          readOnly: true
      command:
        - /bin/sh
        - -c
        - |
          # Wait up to 30s for secondary ENIs to finish kernel hotplug
          for attempt in $(seq 1 30); do
            count=0
            for d in /host/sys/class/net/*; do
              [ -e "$d/device" ] && [ -s "$d/address" ] && count=$((count + 1))
            done
            if [ "$count" -ge 3 ] || [ "$attempt" -ge 15 ]; then
              break
            fi
            sleep 1
          done

          # Program host sysctls, conntrack liberal mode, and kube-proxy Service CIDR NAT rules for dynamically discovered PCI NICs
          nsenter -t 1 -m -u -i -n sh -c '
            sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
            sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1 || true
            sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1 >/dev/null 2>&1 || true
            primary_dev=$(ip -4 route show default 2>/dev/null | awk "{for(i=1;i<=NF;i++) if(\$i==\"dev\"){print \$(i+1); exit}}")
            svc_cidr=""
            if [ -n "$KUBERNETES_SERVICE_HOST" ]; then
              svc_cidr="${KUBERNETES_SERVICE_HOST%.*.*}.0.0/16"
            fi
            if [ -z "$svc_cidr" ]; then
              svc_cidr=$(iptables-save -t nat 2>/dev/null | awk "/^-A KUBE-SERVICES / && /-d / {for(i=1;i<=NF;i++) if(\$i==\"-d\"){split(\$(i+1),a,\".\"); if(length(a)>=2){print a[1]\".\"a[2]\".0.0/16\"; exit}}}")
            fi
            if [ -z "$svc_cidr" ]; then
              svc_cidr=$(iptables-save -t nat 2>/dev/null | awk "/-j KUBE-SERVICES/ && /-d / {for(i=1;i<=NF;i++) if(\$i==\"-d\"){print \$(i+1); exit}}")
            fi
            for d in /sys/class/net/*; do
              [ -e "$d/device" ] || continue
              ifname=$(basename "$d")
              ip link set "$ifname" up 2>/dev/null || true
              ethtool -K "$ifname" tso off gso off gro off tx-nocache-copy off 2>/dev/null || true
              if [ -n "$primary_dev" ] && [ "$ifname" != "$primary_dev" ]; then
                for cidr in $(ip -4 route show dev "$ifname" proto kernel scope link 2>/dev/null | awk "{print \$1}"); do
                  if [ -n "$svc_cidr" ]; then
                    iptables -t nat -C PREROUTING -s "$cidr" -d "$svc_cidr" -j KUBE-SERVICES 2>/dev/null || iptables -t nat -I PREROUTING 1 -s "$cidr" -d "$svc_cidr" -j KUBE-SERVICES 2>/dev/null || true
                  fi
                  iptables -t nat -C POSTROUTING -s "$cidr" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s "$cidr" -j MASQUERADE 2>/dev/null || true
                done
              fi
            done
            iptables -C FORWARD -m conntrack --ctstate INVALID -j ACCEPT 2>/dev/null || iptables -I FORWARD 1 -m conntrack --ctstate INVALID -j ACCEPT 2>/dev/null || true
            imds_token=$(curl -sS -m 2 -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || true)
            if [ -n "$imds_token" ]; then
              primary_mac=$(cat "/sys/class/net/$primary_dev/address" 2>/dev/null | tr "A-F" "a-f")
              vpc_cidr=$(curl -sS -m 2 -H "X-aws-ec2-metadata-token: $imds_token" "http://169.254.169.254/latest/meta-data/network/interfaces/macs/${primary_mac}/vpc-ipv4-cidr-block" 2>/dev/null || true)
              for mac_dir in $(curl -sS -m 2 -H "X-aws-ec2-metadata-token: $imds_token" "http://169.254.169.254/latest/meta-data/network/interfaces/macs/" 2>/dev/null || true); do
                mac=$(echo "$mac_dir" | tr -d "/" | tr "A-F" "a-f")
                [ -n "$mac" ] && [ "$mac" != "$primary_mac" ] || continue
                sub_cidr=$(curl -sS -m 2 -H "X-aws-ec2-metadata-token: $imds_token" "http://169.254.169.254/latest/meta-data/network/interfaces/macs/${mac}/subnet-ipv4-cidr-block" 2>/dev/null || true)
                [ -n "$sub_cidr" ] || continue
                if [ -n "$svc_cidr" ]; then
                  iptables -t nat -C PREROUTING -s "$sub_cidr" -d "$svc_cidr" -j KUBE-SERVICES 2>/dev/null || iptables -t nat -I PREROUTING 1 -s "$sub_cidr" -d "$svc_cidr" -j KUBE-SERVICES 2>/dev/null || true
                fi
                if [ -n "$vpc_cidr" ]; then
                  iptables -t nat -C POSTROUTING -s "$sub_cidr" -d "$vpc_cidr" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s "$sub_cidr" -d "$vpc_cidr" -j MASQUERADE 2>/dev/null || true
                else
                  iptables -t nat -C POSTROUTING -s "$sub_cidr" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s "$sub_cidr" -j MASQUERADE 2>/dev/null || true
                fi
              done
            fi
          ' >/dev/null 2>&1 || true

          out='{'
          sep=''
          for d in /host/sys/class/net/*; do
            i=$(basename "$d")
            [ -e "$d/device" ] || continue
            mac=$(cat "$d/address" 2>/dev/null) || continue
            [ -z "$mac" ] && continue
            pci=$(basename "$(readlink -f "$d/device")") || continue
            [ -z "$pci" ] && continue
            out="${out}${sep}\"${mac}\":{\"ifname\":\"${i}\",\"pci\":\"${pci}\"}"
            sep=','
          done
          out="${out}}"
          printf '%s\n' "$out"
  volumes:
    - name: hostsys
      hostPath:
        path: /sys
