apiVersion: v1
kind: Pod
metadata:
  name: iface-discovery
  namespace: {{ .Namespace }}
spec:
  nodeName: {{ .NodeName }}
  hostNetwork: true
  restartPolicy: Never
  tolerations:
    - operator: Exists
  containers:
    - name: probe
      image: alpine:3.20
      securityContext:
        privileged: true
      volumeMounts:
        - name: hostsys
          mountPath: /host/sys
          readOnly: true
      command:
        - /bin/sh
        - -c
        - |
          # Wait up to 30s for secondary ENIs to finish kernel hotplug
          for attempt in $(seq 1 30); do
            count=0
            for d in /host/sys/class/net/*; do
              [ -e "$d/device" ] && [ -s "$d/address" ] && count=$((count + 1))
            done
            if [ "$count" -ge 3 ] || [ "$attempt" -ge 15 ]; then
              break
            fi
            sleep 1
          done

          out='{'
          sep=''
          for d in /host/sys/class/net/*; do
            i=$(basename "$d")
            [ -e "$d/device" ] || continue
            mac=$(cat "$d/address" 2>/dev/null) || continue
            [ -z "$mac" ] && continue
            pci=$(basename "$(readlink -f "$d/device")") || continue
            [ -z "$pci" ] && continue
            out="${out}${sep}\"${mac}\":{\"ifname\":\"${i}\",\"pci\":\"${pci}\"}"
            sep=','
          done
          out="${out}}"
          printf '%s\n' "$out"
  volumes:
    - name: hostsys
      hostPath:
        path: /sys
