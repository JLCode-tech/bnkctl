apiVersion: v1
kind: Pod
metadata:
  name: iface-discovery
  namespace: {{ .Namespace }}
spec:
  nodeName: {{ .NodeName }}
  hostNetwork: true
  hostPID: true
  restartPolicy: Never
  tolerations:
    - operator: Exists
  containers:
    - name: probe
      image: alpine:3.20
      securityContext:
        privileged: true
      volumeMounts:
        - name: hostsys
          mountPath: /host/sys
          readOnly: true
      command:
        - /bin/sh
        - -c
        - |
          # Wait up to 30s for secondary ENIs to finish kernel hotplug
          for attempt in $(seq 1 30); do
            count=0
            for d in /host/sys/class/net/*; do
              [ -e "$d/device" ] && [ -s "$d/address" ] && count=$((count + 1))
            done
            if [ "$count" -ge 3 ] || [ "$attempt" -ge 15 ]; then
              break
            fi
            sleep 1
          done

          # Program host sysctls, conntrack liberal mode, and kube-proxy Service CIDR NAT rules for dynamically discovered PCI NICs
          nsenter -t 1 -m -u -i -n sh -c '
            sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
            sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1 || true
            sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1 >/dev/null 2>&1 || true
            primary_dev=$(ip -4 route show default 2>/dev/null | awk "{for(i=1;i<=NF;i++) if(\$i==\"dev\"){print \$(i+1); exit}}")
            for d in /sys/class/net/*; do
              [ -e "$d/device" ] || continue
              ifname=$(basename "$d")
              ip link set "$ifname" up 2>/dev/null || true
              ethtool -K "$ifname" tso off gso off gro off tx-nocache-copy off 2>/dev/null || true
              if [ -n "$primary_dev" ] && [ "$ifname" != "$primary_dev" ]; then
                for cidr in $(ip -4 route show dev "$ifname" proto kernel scope link 2>/dev/null | awk "{print \$1}"); do
                  iptables -t nat -C PREROUTING -s "$cidr" -d 172.20.0.0/16 -j KUBE-SERVICES 2>/dev/null || iptables -t nat -I PREROUTING 1 -s "$cidr" -d 172.20.0.0/16 -j KUBE-SERVICES 2>/dev/null || true
                  iptables -t nat -C POSTROUTING -s "$cidr" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s "$cidr" -j MASQUERADE 2>/dev/null || true
                done
              fi
            done
            iptables -C FORWARD -m conntrack --ctstate INVALID -j ACCEPT 2>/dev/null || iptables -I FORWARD 1 -m conntrack --ctstate INVALID -j ACCEPT 2>/dev/null || true
            iptables -t nat -C PREROUTING -s 10.0.10.0/24 -d 172.20.0.0/16 -j KUBE-SERVICES 2>/dev/null || iptables -t nat -I PREROUTING 1 -s 10.0.10.0/24 -d 172.20.0.0/16 -j KUBE-SERVICES 2>/dev/null || true
            iptables -t nat -C PREROUTING -s 10.0.20.0/24 -d 172.20.0.0/16 -j KUBE-SERVICES 2>/dev/null || iptables -t nat -I PREROUTING 1 -s 10.0.20.0/24 -d 172.20.0.0/16 -j KUBE-SERVICES 2>/dev/null || true
            iptables -t nat -C POSTROUTING -s 10.0.10.0/24 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.0.10.0/24 -j MASQUERADE 2>/dev/null || true
            iptables -t nat -C POSTROUTING -s 10.0.20.0/24 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.0.20.0/24 -j MASQUERADE 2>/dev/null || true
          ' >/dev/null 2>&1 || true

          out='{'
          sep=''
          for d in /host/sys/class/net/*; do
            i=$(basename "$d")
            [ -e "$d/device" ] || continue
            mac=$(cat "$d/address" 2>/dev/null) || continue
            [ -z "$mac" ] && continue
            pci=$(basename "$(readlink -f "$d/device")") || continue
            [ -z "$pci" ] && continue
            out="${out}${sep}\"${mac}\":{\"ifname\":\"${i}\",\"pci\":\"${pci}\"}"
            sep=','
          done
          out="${out}}"
          printf '%s\n' "$out"
  volumes:
    - name: hostsys
      hostPath:
        path: /sys
