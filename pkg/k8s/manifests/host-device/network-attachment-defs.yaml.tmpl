apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: {{ .ExternalNADName }}
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "external-network",
      "type": "host-device",
      "pciBusID": "{{ .ExternalPCI }}"
    }
{{- if .HasInternal }}
---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: {{ .InternalNADName }}
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "internal-network",
      "type": "host-device",
      "pciBusID": "{{ .InternalPCI }}"
    }
{{- end }}
